ObjC.import("Foundation");
ObjC.import("WebKit");
ObjC.import("AppKit");

const rootPath = ObjC.unwrap($.NSFileManager.defaultManager.currentDirectoryPath);
const rootUrl = $.NSURL.fileURLWithPathIsDirectory(rootPath, true);
const url = $.NSURL.fileURLWithPath(`${rootPath}/index.html`);

$.NSApplication.sharedApplication;

const config = $.WKWebViewConfiguration.alloc.init;
config.websiteDataStore = $.WKWebsiteDataStore.nonPersistentDataStore;

const webView = $.WKWebView.alloc.initWithFrameConfiguration($.NSMakeRect(0, 0, 1440, 960), config);
const runLoop = $.NSRunLoop.currentRunLoop;

webView.loadFileURLAllowingReadAccessToURL(url, rootUrl);
runLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.5));
waitForLoad();
waitForExpression("document.querySelectorAll('.resource-card').length >= 35", 10000);

runStep("initial render", `
  assert(text("#siteTitle").includes("Elgin Homeless Resource Map"), "title renders");
  assert(qa(".resource-marker").length >= 35, "pins render");
  assert(qa(".resource-card").length >= 35, "resource cards render");
  const cardRects = qa(".resource-card").map((card) => card.getBoundingClientRect());
  assert(cardRects.every((rect, index) => index === cardRects.length - 1 || rect.bottom <= cardRects[index + 1].top + 1), "resource cards do not overlap");
  const mapRect = q(".real-map").getBoundingClientRect();
  const mapAreaRect = q(".map-area").getBoundingClientRect();
  assert(Math.abs(mapRect.width - mapRect.height) <= 2, "map renders as a square");
  assert(Math.abs(q(".sidebar").getBoundingClientRect().height - mapAreaRect.height) <= 3, "search panel matches map height");
  assert(Math.abs(q("#detailPanel").getBoundingClientRect().height - mapAreaRect.height) <= 3, "detail panel matches map height");
  assert(getComputedStyle(q("#resourceList")).overflowY === "scroll", "resource list is the left-panel scroll area");
  assert(getComputedStyle(q("#detailPanel")).overflowY !== "hidden", "detail panel can scroll");
  assert(getComputedStyle(q(".scroll-more-cue")).display !== "none", "scroll cue is visible when more resources remain");
  assert(getComputedStyle(q(".resource-list-fade")).display !== "none", "scroll fade is visible when more resources remain");
  assert(q(".resource-list").classList.contains("can-scroll"), "resource list exposes persistent scroll affordance");
  assert(getComputedStyle(q(".resource-list"), "::after").width === "6px", "resource list has a visible scroll thumb");
  q("#resourceList").scrollTop = q("#resourceList").scrollHeight;
  q("#resourceList").dispatchEvent(new Event("scroll", { bubbles: true }));
  assert(getComputedStyle(q(".scroll-more-cue")).display === "none", "scroll cue hides at list bottom");
  q("#resourceList").scrollTop = 0;
  q("#resourceList").dispatchEvent(new Event("scroll", { bubbles: true }));
  return { cardCount: qa(".resource-card").length, pinCount: qa(".resource-marker").length };
`);

runStep("search and directions", `
  setValue("#searchInput", "PADS");
  assert(text(".resource-card .card-title").includes("PADS of Elgin"), "search finds PADS");
  click(".resource-card");
  assert(text("#detailPanel h2").includes("PADS of Elgin"), "card click opens details");
  assert((q("#directionsLink") || {}).href.includes("google.com/maps/dir"), "directions link is Google Maps");
  assert(getComputedStyle(q(".contact-link[href^='tel:']")).backgroundColor === "rgb(21, 95, 91)", "call action is visually primary");
  assert(getComputedStyle(q("#directionsLink")).backgroundColor === "rgb(238, 248, 247)", "directions action is second priority");
  assert(!!q(".chip-count"), "category chips include counts");
  assert(qa(".quick-stats div").length === 2, "stats strip has two stat pills");
  assert(!text(".quick-stats").toLowerCase().includes("crisis"), "crisis is not a stats pill");
  assert(!q("#crisisResourcesBtn"), "crisis resources CTA is removed");
  assert(!!q(".scroll-more-cue"), "resource list has scroll cue");
`);

runStep("filters and pins", `
  click("#resetViewBtn");
  setValue("#categoryFilter", "Medical", "change");
  assert(qa(".resource-card").length >= 8, "medical category filter works");
  q("#openNowFilter").checked = true;
  q("#openNowFilter").dispatchEvent(new Event("change", { bubbles: true }));
  assert(qa(".resource-card").length >= 1, "open-now filter works");
  q("#openNowFilter").checked = false;
  q("#openNowFilter").dispatchEvent(new Event("change", { bubbles: true }));
  click(".resource-marker");
  assert(text("#detailPanel h2").length > 0, "pin click opens details");
  click("#resetViewBtn");
  setValue("#categoryFilter", "Crisis", "change");
  assert(q("#categoryFilter").value === "Crisis", "crisis category remains available in filters");
  click("#resetViewBtn");
  setValue("#categoryFilter", "Meals", "change");
  setValue("#searchInput", "PADS");
  assert(text(".resource-card .card-title").includes("PADS of Elgin"), "multi-category resource appears in secondary category");
  click("#resetViewBtn");
  setValue("#sortFilter", "name-desc", "change");
  assert(text(".resource-card .card-title").includes("Zion Lutheran Church"), "main resource list sorts Z-A");
`);

runStep("location directions", `
  Object.defineProperty(navigator, "geolocation", {
    configurable: true,
    value: {
      getCurrentPosition(success) {
        success({ coords: { latitude: 42.038, longitude: -88.286 } });
      },
    },
  });
  click("#useLocationBtn");
  assert(text("#useLocationBtn").includes("Location ready"), "location button handles success");
  assert((q("#directionsLink") || {}).href.includes("origin=42.038%2C-88.286"), "directions include current location origin");
`);

runStep("admin lock and inline design", `
  click("#adminOpenBtn");
  assert(!!q("#adminPassword"), "admin starts locked");
  q("#adminDialog").close();
  assert(getComputedStyle(q("#editPageBtn")).display === "none", "edit page button is hidden for non-admins");
  assert(q("#editPageBtn").disabled === true, "edit page button is disabled for non-admins");
  assert(q("#editPageBtn").getAttribute("aria-hidden") === "true", "edit page button is removed from non-admin accessibility tree");
  q("#editPageBtn").classList.remove("hidden");
  q("#editPageBtn").disabled = false;
  q("#editPageBtn").click();
  assert(q("#inlineEditor").classList.contains("hidden"), "forced non-admin click cannot enter edit mode");
  q("#editPageBtn").classList.add("hidden");
  q("#editPageBtn").disabled = true;
  assert(getComputedStyle(q("#adminOpenBtn")).backgroundColor === "rgba(0, 0, 0, 0)", "admin button is low-emphasis");
  sessionStorage.setItem("elginResourceMap.adminSession.v1", "true");
  click("#adminOpenBtn");
  assert(text(".admin-header h2").includes("Administrator Panel"), "admin panel opens after session unlock");
  assert(!!q("button[data-tab='content']"), "resources tab remains in modal");
  assert(!!q("button[data-tab='categories']"), "categories tab remains in modal");
  assert(!!q("button[data-tab='import']"), "import/export tab remains as utility tab");
  assert(!q("button[data-tab='design']") && !q("button[data-tab='panels']") && !q("button[data-tab='arrange']"), "design panels and arrange tabs are removed from modal");
  q("#adminDialog").close();
  assert(getComputedStyle(q("#editPageBtn")).display !== "none", "edit page button is visible for admins");
  click("#editPageBtn");
  assert(!q("#inlineEditor").classList.contains("hidden"), "inline editor opens from public page");
  assert(getComputedStyle(document.body, "::before").position === "fixed", "edit mode has a visible viewport indicator");
  assert(!!q("[data-inline-action='open-panel'][data-panel='typography']"), "inline toolbar exposes typography panel");
  assert(!!q("[data-inline-action='open-panel'][data-panel='colors']"), "inline toolbar exposes colors panel");
  assert(!!q("[data-inline-action='open-panel'][data-panel='spacing']"), "inline toolbar exposes spacing panel");
  assert(!!q("select[name='fontGlobal']"), "inline editor exposes site-wide font control");
  assert(!!q("select[name='fontDetailPane']"), "inline editor exposes per-section font override");
  assert(!!q("input[name='designHeaderPaddingY']"), "inline editor exposes header padding control");
  assert(!!q("input[name='designCardRadius']"), "inline editor exposes shape controls");
  assert(!!q("input[name='sidebarWidth']"), "inline editor exposes panel sizing controls");
  setValue("#inlineEditor input[name='title']", "Test Elgin Resource Dashboard");
  setValue("#inlineEditor input[name='mapLabel']", "Testing map label");
  setValue("#inlineEditor select[name='fontGlobal']", "Helvetica", "change");
  setValue("#inlineEditor select[name='fontStats']", "Montserrat", "change");
  click("#inlineEditor [data-inline-action='open-panel'][data-panel='spacing']");
  setValue("#inlineEditor input[name='designHeaderPaddingY']", "28");
  setValue("#inlineEditor input[name='pinSize']", "44");
  assert(getComputedStyle(q(".resource-marker")).width === "44px", "default map pins resize live while editing");
  click("#inlineEditor [data-inline-action='save']");
  assert(text("#siteTitle").includes("Test Elgin Resource Dashboard"), "design title updates");
  assert(text("#mapLabel").includes("Testing map label"), "map label updates");
  assert(getComputedStyle(q(".topbar")).paddingTop === "28px", "header padding updates");
  assert(getComputedStyle(document.body).fontFamily.includes("Helvetica"), "site-wide font updates");
  assert(getComputedStyle(q(".quick-stats strong")).fontFamily.includes("Montserrat"), "stats font override updates");
  click("#editPageBtn");
  setValue("#inlineEditor input[name='title']", "Temporary Title");
  click("#inlineEditor [data-inline-action='reset-control'][data-scope='setting'][data-field='title']");
  assert(q("#inlineEditor input[name='title']").value === "Elgin Homeless Resource Map", "individual inline fields can reset to defaults");
  const start = new Event("dragstart", { bubbles: true });
  start.dataTransfer = { effectAllowed: "", setData() {} };
  q("#adminOpenBtn").dispatchEvent(start);
  const drop = new Event("drop", { bubbles: true });
  drop.dataTransfer = { dropEffect: "" };
  q("#useLocationBtn").dispatchEvent(drop);
  assert(Number(getComputedStyle(q("#adminOpenBtn")).order) < Number(getComputedStyle(q("#useLocationBtn")).order), "arrangement controls reorder header actions");
  click("#inlineEditor [data-inline-action='reset-order']");
  assert(Number(getComputedStyle(q("#useLocationBtn")).order) < Number(getComputedStyle(q("#adminOpenBtn")).order), "arrangement reset restores header actions");
  click("#inlineEditor [data-inline-action='discard']");
`);

runStep("admin categories", `
  click("#adminOpenBtn");
  click("button[data-tab='categories']");
  assert(!!q(".admin-category-item .admin-card-title"), "category list uses public-style cards");
  click("button[data-action='new-category']");
  setValue("input[name='name']", "Test Category");
  setValue("input[name='icon']", "TC");
  setValue("input[name='color']", "#123456", "input");
  assert(q("[data-color-picker='color']").value.toLowerCase() === "#123456", "category color picker syncs from hex input");
  clickText("button", "Save category");
  assert(Array.from(document.querySelectorAll("#categoryFilter option")).some((option) => option.value === "Test Category") || text(".admin-list").includes("Test Category"), "admin can add/edit category");
  click("button[data-action='save-category-default']");
  setValue("input[name='icon']", "ZZ");
  setValue("input[name='color']", "#abcdef", "input");
  click("button[data-action='reset-category']");
  assert(q("input[name='icon']").value === "TC", "category icon resets to saved default");
  assert(q("input[name='color']").value.toLowerCase() === "#123456", "category color resets to saved default");
  click("button[data-action='delete-category']");
  assert(!text(".admin-list").includes("Test Category"), "admin can remove category");
  click("button[data-action='select-category'][data-category='Meals']");
  assert(!!q(".related-resources"), "category editor shows assigned resources");
  click(".related-resource-chip");
  assert(!!q("#resourceForm"), "clicking a related resource opens resources editor");
  q("#adminDialog").close();
  click("#editPageBtn");
  click("#inlineEditor [data-inline-action='open-panel'][data-panel='spacing']");
  setValue("#inlineEditor input[name='sidebarWidth']", "420");
  setValue("#inlineEditor input[name='detailWidth']", "440");
  setValue("#inlineEditor input[name='mapMinHeight']", "640");
  q("#inlineEditor input[name='showStatsPanel']").checked = false;
  q("#inlineEditor input[name='showStatsPanel']").dispatchEvent(new Event("change", { bubbles: true }));
  q("#inlineEditor input[name='showDetailPanel']").checked = false;
  q("#inlineEditor input[name='showDetailPanel']").dispatchEvent(new Event("change", { bubbles: true }));
  click(".inline-visibility-toggle[data-feature='showMapToolbar']");
  assert(q(".map-toolbar").classList.contains("edit-hidden-block"), "inline eye toggle previews hidden blocks during edit mode");
  assert(!!q(".inline-resize-handle.right"), "inline panel resize handles are present");
  const down = new MouseEvent("mousedown", { bubbles: true, clientX: 340, clientY: 300 });
  q(".sidebar .inline-resize-handle.right").dispatchEvent(down);
  document.dispatchEvent(new MouseEvent("mousemove", { bubbles: true, clientX: 380, clientY: 300 }));
  document.dispatchEvent(new MouseEvent("mouseup", { bubbles: true, clientX: 380, clientY: 300 }));
  assert(getComputedStyle(document.documentElement).getPropertyValue("--sidebar-width").trim() !== "420px", "dragging a panel edge resizes live");
  click("#inlineEditor [data-inline-action='save']");
  assert(getComputedStyle(document.documentElement).getPropertyValue("--map-min-height").trim() === "640px", "panel map height updates");
  assert(q(".quick-stats").classList.contains("hidden"), "stats panel can be hidden");
  assert(q(".dashboard").classList.contains("detail-hidden"), "details panel can be hidden");
  click("#editPageBtn");
  click("#inlineEditor [data-inline-action='open-panel'][data-panel='spacing']");
  q("#inlineEditor input[name='showStatsPanel']").checked = true;
  q("#inlineEditor input[name='showStatsPanel']").dispatchEvent(new Event("change", { bubbles: true }));
  q("#inlineEditor input[name='showDetailPanel']").checked = true;
  q("#inlineEditor input[name='showDetailPanel']").dispatchEvent(new Event("change", { bubbles: true }));
  click("#inlineEditor [data-inline-action='save']");
  assert(!q(".dashboard").classList.contains("detail-hidden"), "details panel can be restored");
`);

