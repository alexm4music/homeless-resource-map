  click("#adminOpenBtn");
  click("button[data-tab='content']");
  setValue("#adminResourceSort", "name-desc", "change");
  assert(text(".admin-resource-item").includes("Zion Lutheran Church"), "admin resource list sorts Z-A");
  assert(!!q(".admin-resource-item .admin-card-dot"), "admin resource rows use card dots");
  click("button[data-action='new-resource']");
  setValue("input[name='name']", "Test Resource");
  setValue("select[name='category']", "Community", "change");
  setValue("input[name='address']", "1 Test Way, Elgin, IL");
  setValue("input[name='lat']", "42.039");
  setValue("input[name='lng']", "-88.287");
  setValue("textarea[name='services']", "Test service");
  setValue("textarea[name='hoursText']", "Monday 10:00 AM-11:00 AM");
  setValue("input[name='pinIcon']", "TR");
  setValue("input[name='pinColor']", "#123456");
  assert(q("[data-color-picker='pinColor']").value.toLowerCase() === "#123456", "resource pin color picker syncs from hex input");
  setValue("input[name='pinSize']", "48");
  assert(getComputedStyle(q(".pin-preview-marker")).width === "48px", "resource pin size preview follows slider/input");
  q("input[name='resourceCategory'][value='Meals']").checked = true;
  q("input[name='scheduleDay'][value='1']").checked = true;
  setValue("input[name='scheduleStart']", "10:00");
  setValue("input[name='scheduleEnd']", "11:00");
  click("button[data-action='add-schedule']");
  click("button[data-action='save-resource-default']");
  setValue("input[name='name']", "Changed Test Resource");
  setValue("input[name='pinIcon']", "XX");
  click("button[data-action='reset-resource']");
  assert(q("input[name='name']").value === "Test Resource", "resource resets to saved default");
  assert(q("input[name='pinIcon']").value === "TR", "resource pin icon resets to saved default");
  clickText("button", "Save resource");
  q("#adminDialog").close();
  click("#resetViewBtn");
  setValue("#categoryFilter", "Meals", "change");
  setValue("#searchInput", "Test Resource");
  assert(text(".resource-card .card-title").includes("Test Resource"), "admin can create a resource tagged with a secondary category");
  assert(text(".resource-marker").includes("TR"), "admin can edit a pin icon");
  assert(q(".resource-marker").style.getPropertyValue("--pin-color").trim().toLowerCase() === "#123456", "admin can edit a pin color");
  click("#adminOpenBtn");
  click("button[data-action='delete-resource']");
  q("#adminDialog").close();
  click("#resetViewBtn");
  setValue("#searchInput", "Test Resource");
  assert(text(".empty-state strong").includes("No matching resources"), "admin can delete resource");
`);

runStep("export and mobile presence", `
  click("#adminOpenBtn");
  click("button[data-tab='import']");
  click("button[data-action='export-json']");
  const exported = JSON.parse(q("#importExportText").value);
  assert(Array.isArray(exported.resources), "export includes resources");
  assert(!!exported.settings.title, "export includes settings");
  exported.settings.title = "Imported Test Dashboard";
  q("#importExportText").value = JSON.stringify(exported);
  click("button[data-action='import-json']");
  assert(text("#siteTitle").includes("Imported Test Dashboard"), "import applies settings");
  click("button[data-action='reset-defaults']");
  assert(text("#siteTitle").includes("Elgin Homeless Resource Map"), "reset restores defaults");
  document.documentElement.style.width = "390px";
  window.dispatchEvent(new Event("resize"));
  assert(!!q(".real-map"), "map remains present at mobile width");
  assert(document.body.scrollWidth <= window.innerWidth, "mobile layout does not create horizontal page overflow");
  q("#adminDialog").close();
  click("#resetViewBtn");
`);

const counts = JSON.parse(evalJavaScript(`JSON.stringify({
  cardCount: document.querySelectorAll(".resource-card").length,
  pinCount: document.querySelectorAll(".resource-marker").length
})`, 5000));

print(`All WKWebView smoke tests passed. Cards: ${counts.cardCount}. Pins: ${counts.pinCount}.`);

function waitForLoad() {
  const deadline = Date.now() + 15000;
  while (webView.loading && Date.now() < deadline) {
    runLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.1));
  }
}

function waitForExpression(expression, timeoutMs) {
  const deadline = Date.now() + timeoutMs;
  while (Date.now() < deadline) {
    const script = `String(Boolean(${expression}))`;
    const value = evalJavaScript(script, 2000);
    if (value === "true") return;
    runLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.1));
  }
  throw new Error("Timed out waiting for " + expression);
}

function evalJavaScript(script, timeoutMs) {
  let done = false;
  let output = undefined;
  let errorMessage = "";
  webView.evaluateJavaScriptCompletionHandler(script, (result, error) => {
    if (ObjC.unwrap(error) !== undefined) {
      errorMessage = String(ObjC.unwrap(error.localizedDescription) || error);
    } else {
      output = ObjC.unwrap(result);
    }
    done = true;
  });
  const deadline = Date.now() + timeoutMs;
  while (!done && Date.now() < deadline) {
    runLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.1));
  }
  if (!done) throw new Error("Timed out evaluating JavaScript");
  if (errorMessage) throw new Error(errorMessage);
  return output;
}

function runStep(name, body) {
  const wrapped = `
    (function () {
      const failures = [];
      window.confirm = () => true;
      function assert(condition, message) {
        if (!condition) failures.push(message);
      }
      function q(selector) {
        return document.querySelector(selector);
      }
      function qa(selector) {
        return Array.from(document.querySelectorAll(selector));
      }
      function text(selector) {
        const el = q(selector);
        return el ? el.textContent.trim() : "";
      }
      function setValue(selector, value, eventName) {
        const el = q(selector);
        assert(el, "Missing control: " + selector);
        if (!el) return;
        el.value = value;
        el.dispatchEvent(new Event(eventName || "input", { bubbles: true }));
      }
      function click(selector) {
        const el = q(selector);
        assert(el, "Missing button/control: " + selector);
        if (el) el.click();
      }
      function clickText(selector, fragment) {
        const el = qa(selector).find((item) => item.textContent.includes(fragment));
        assert(el, "Missing text button: " + fragment);
        if (el) el.click();
      }
      try {
        const extra = (function () {
          ${body}
          return {};
        })() || {};
        return JSON.stringify({ ok: failures.length === 0, failures, extra });
      } catch (error) {
        return JSON.stringify({
          ok: false,
          failures: [error && error.message ? error.message : String(error), error && error.stack ? error.stack : ""],
        });
      }
    })()
  `;
  const result = JSON.parse(evalJavaScript("String(" + wrapped + ")", 10000));
  if (!result.ok) {
    print(`Step failed: ${name}`);
    print(JSON.stringify(result, null, 2));
    throw new Error(result.failures.join("\\n"));
  }
  print(`Passed: ${name}`);
  return result.extra;
}

function print(value) {
  const data = $.NSString.alloc.initWithUTF8String(String(value) + "\n").dataUsingEncoding($.NSUTF8StringEncoding);
  $.NSFileHandle.fileHandleWithStandardOutput.writeData(data);
}
